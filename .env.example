# Portfolio Contact Form Email Configuration
# To receive form submissions directly in your Gmail inbox:
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate an App Password for 'Mail': https://myaccount.google.com/apppasswords
# 3. Paste the 16-character password below into SMTP_PASS:

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=syedumairshah763@gmail.com
SMTP_PASS= 
CONTACT_RECEIVER_EMAIL=syedumairshah763@gmail.com

